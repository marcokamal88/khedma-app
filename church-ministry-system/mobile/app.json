{
  "expo": {
    "name": "Khedma App",
    "slug": "khedma-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4A90D9"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.church.ministry"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A90D9"
      },
      "package": "com.church.ministry",
      "permissions": ["DETECT_SCREEN_CAPTURE", "RECEIVE_BOOT_COMPLETED", "VIBRATE"],
      "googleServicesFile": "./google-services.json"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#4A90D9",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "Khedma App"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A90D9",
          "sounds": ["./assets/notification-sound.wav"]
        }
      ]
    ]
  }
}
